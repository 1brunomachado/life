---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import AppImage from "@/components/AppImage.astro";
import profImage from "@/assets/placeholder.jpg";

const professionals = [
  {
    badge: "Plano cintura fina",
    name: "Bibi Fitness",
    description:
      "Referência em fitness no Brasil, com milhões de seguidores, reconhecida por democratizar o treino em casa com leveza e consistência.",
  },
  {
    badge: "Corrida guiada",
    name: "Nini Oliveira",
    description:
      "Criadora reconhecida por unir treino, autoestima e saúde mental, com uma comunidade engajada em torno do bem-estar integral.",
  },
  {
    badge: "Go gap",
    name: "Bruno Leal",
    description:
      "Profissional de educação física com forte presença digital, conhecido pelos treinos funcionais voltados à qualidade de vida e longevidade.",
  },
  {
    badge: "Hatha yoga",
    name: "Pamela Otero",
    description:
      "Especialista em mobilidade e saúde da mulher, referência em treinos que unem flexibilidade, força e cuidado feminino.",
  },
  {
    badge: "Pilates em casa",
    name: "Matheus Garofalo",
    description:
      "Atleta e criador conhecido por conteúdos de força, hipertrofia e performance, com método acessível para diferentes níveis de treino.",
  },
  {
    badge: "MMA training",
    name: "Rafa Pereira",
    description:
      "Treinador especializado em artes marciais mistas, traz para a plataforma treinos de alta intensidade inspirados nos movimentos do MMA.",
  },
];
---

<section id="professionals" class="section">
  <div class="container stack stack--gap-6">
    <div class="stack">
      <p>Profissionais da plataforma</p>
      <h2 id="professionals-heading">Quem treina com você</h2>
      <p>Especialistas e criadores reconhecidos guiando sua jornada — do treino à saúde mental.</p>
    </div>
    <div class="stack">
      <div
        class="professionals__viewport"
        role="region"
        aria-roledescription="carousel"
        aria-labelledby="professionals-heading"
        data-professionals-embla
      >
        <ul class="professionals__grid">
          {professionals.map((professional, index) => (
            <li
              class="professionals__slide"
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} de ${professionals.length}`}
            >
              <AppImage class="professionals__image" src={profImage} alt="" />
              <div class="stack stack--gap-1">
                <span>{professional.badge}</span>
                <h3>{professional.name}</h3>
                <p>{professional.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="professionals__controls">
        <button
          type="button"
          class="professionals__control"
          data-professionals-prev
          aria-label="Profissional anterior"
          disabled
        >
          <ChevronLeft aria-hidden="true" />
        </button>
        <button type="button" class="professionals__control" data-professionals-next aria-label="Próximo profissional">
          <ChevronRight aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from "embla-carousel";

  const viewport = document.querySelector<HTMLElement>("[data-professionals-embla]");

  if (viewport) {
    const prevButton = document.querySelector<HTMLButtonElement>("[data-professionals-prev]");
    const nextButton = document.querySelector<HTMLButtonElement>("[data-professionals-next]");

    const emblaApi = EmblaCarousel(viewport, {
      align: "start",
      containScroll: "trimSnaps",
      breakpoints: {
        "(min-width: 992px)": { active: false },
        "(prefers-reduced-motion: reduce)": { duration: 0 },
      },
    });

    const syncControls = () => {
      if (prevButton) prevButton.disabled = !emblaApi.canScrollPrev();
      if (nextButton) nextButton.disabled = !emblaApi.canScrollNext();
    };

    prevButton?.addEventListener("click", () => emblaApi.scrollPrev());
    nextButton?.addEventListener("click", () => emblaApi.scrollNext());

    emblaApi.on("pointerDown", () => viewport.classList.add("is-dragging"));
    emblaApi.on("pointerUp", () => viewport.classList.remove("is-dragging"));
    emblaApi.on("select", syncControls);
    emblaApi.on("reInit", syncControls);

    syncControls();
  }
</script>
