---

<section id="faq" class="section">
  <div class="container stack stack--gap-6">
    <div class="stack">
      <p>Dúvidas</p>
      <h2>Perguntas frequentes</h2>
    </div>
    <div class="stack">
      {faqItems.map((item) => (
        <details>
          <summary class="split">
            <span>{item.question}</span>
            <ChevronDown aria-hidden="true" />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
