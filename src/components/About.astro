---
import { ChevronsRight } from "@lucide/astro";

const aboutSteps = [
  { title: "Escolha seu plano", description: "Selecione o plano que combina com seu momento de vida." },
  { title: "Receba o acesso", description: "Em poucos minutos, seus dados chegam no seu e-mail." },
  { title: "Comece sua jornada", description: "Preencha o questionário e siga sua trilha personalizada." },
  { title: "Suporte técnico", description: "Esclareça dúvidas sobre a plataforma, acesso e assinatura." },
];
---

<section id="about" class="section">
  <div class="container stack stack--gap-6">
    <div class="stack">
      <p>Sobre</p>
      <h2>Tudo que você precisa para cuidar de si</h2>
    </div>
    <ul class="about__grid grid">
      {aboutSteps.map((step, index) => (
        <li class="stack stack--gap-1">
          <div class="split">
            <span>{index + 1}.</span>
            <ChevronsRight aria-hidden="true" />
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
